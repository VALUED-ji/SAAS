{
  "name": "renovation-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev NODE_OPTIONS=--max-old-space-size=1536 next dev --disable-source-maps --port 3459",
    "build": "bash scripts/build-next.sh",
    "start": "NEXT_DIST_DIR=.next-build next start",
    "lint": "eslint .",
    "lint:hooks": "eslint . --quiet --rule 'react-hooks/exhaustive-deps:error'",
    "typecheck": "tsc --noEmit --incremental false",
    "codex:finish": "bash scripts/codex-finish.sh",
    "test": "vitest run",
    "check:security": "node scripts/check-security.cjs",
    "check:database": "node scripts/check-database.cjs",
    "verify:local": "npm run lint && npm run typecheck && npm run test && npm run check:security && npm run check:database && npm run build",
    "release:clean": "bash scripts/create-release.sh"
  },
