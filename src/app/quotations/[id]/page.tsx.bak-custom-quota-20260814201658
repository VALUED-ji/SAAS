    autoSaveTimerRef.current = window.setTimeout(async () => {
      const runId = autoSaveRunRef.current + 1;
      autoSaveRunRef.current = runId;
      setAutoSaveStatus("saving");
      try {
        const res = await fetch(`/api/quotations/${quotationId}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json", ...authHeaders() },
          body: savePayloadText,
        });
        if (!res.ok) {
          const err = await res.json().catch(() => ({ message: "自动保存失败" }));
          throw new Error(err.message || "自动保存失败");
        }
        if (autoSaveRunRef.current !== runId) return;
        lastSavedPayloadRef.current = savePayloadText;
        setAutoSaveStatus("saved");
      } catch {
        if (autoSaveRunRef.current !== runId) return;
        setAutoSaveStatus("error");
      }
    }, 900);

    return () => {
      if (autoSaveTimerRef.current) window.clearTimeout(autoSaveTimerRef.current);
    };
  }, [isReadonly, loading, quotationId, savePayloadText]);

