function getCategoryLabel(category: string) {
  return builtInCategoryLabels[category] || category;
}

function isOtherCategory(category: string) {
  return category === "other";
}

function normalizeCategoryName(category: unknown) {
  return String(category || "").trim();
}

function getCategoryKey(category: unknown) {
  const name = normalizeCategoryName(category);
  if (name === "base" || name === "基装" || name === "基装项目") return "base";
  if (name === "main_material" || name === "主材" || name === "主材项目") return "main_material";
  if (name === "other") return "other";
  return name;
}

function sameQuoteCategory(left: unknown, right: unknown) {
  return getCategoryKey(left) === getCategoryKey(right);
}

function isBaseCategory(category: string) {
  return getCategoryKey(category) === "base";
}

function isMainMaterialCategory(category: string) {
  return getCategoryKey(category) === "main_material";
}

function isCustomCabinetCategory(category: string) {
  return category.trim() === "定制柜";
}

function isDirectItemCategory(category: string) {
  return !isOtherCategory(category);
}

function isPackagePricingCategory(category: unknown) {
  const name = normalizeCategoryName(category);
  return name === "package_price" || name === "一口价";
}

function orderQuoteCategories(categories: string[]) {
  const normalized: string[] = [];
  const seenKeys = new Set<string>();
  categories.map((category) => String(category || "").trim()).filter(Boolean).forEach((category) => {
    const key = getCategoryKey(category);
    if (seenKeys.has(key)) return;
    seenKeys.add(key);
    normalized.push(key === "base" || key === "main_material" || key === "other" ? key : category);
  });
  const directBuiltIns = builtInDirectCategories.filter((category) => normalized.some((item) => sameQuoteCategory(item, category)));
  const customCategories = normalized.filter((category) => !builtInDirectCategories.some((item) => sameQuoteCategory(category, item)) && !isOtherCategory(category) && !isPackagePricingCategory(category));
  return [...directBuiltIns, ...customCategories, "other"];
}

function getQuoteCategoriesForItems(categories: string[], items: Pick<QuotationItem, "category">[]) {
  const itemCategorySet = new Set(items.map((item) => String(item.category || "").trim()).filter(Boolean));
  return orderQuoteCategories([...categories, ...Array.from(itemCategorySet)]);
}

