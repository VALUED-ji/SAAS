      if (lastSavedPayloadRef.current === savePayloadText) return;
      fetch(`/api/quotations/${quotationId}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json", ...authHeaders() },
        body: savePayloadText,
        keepalive: true,
      }).catch(() => {});
